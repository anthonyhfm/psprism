        std::ofstream stream(platform_directory / "psp" / "platform.cpp",
                             std::ios::binary | std::ios::trunc);
        if (!stream) {
            throw std::runtime_error("cannot create generated import bridge");
        }
        stream << "// Generated by psprecomp. Do not edit.\n"
