                  "#include <pspkernel.h>\n"
                  "#include <cstddef>\n"
                  "#include <cstdint>\n"
                  "#include <cstring>\n\n"
                  "extern \"C\" unsigned char native_guest_image_start[];\n"
                  "extern char __lib_ent_top[], __lib_ent_bottom[];\n"
