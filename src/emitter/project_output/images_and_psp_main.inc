                   "static_cast<unsigned int>(state.stop_reason), "
                   "static_cast<unsigned int>(state.pc - base), "
                   "static_cast<unsigned int>(state.gpr[28]), "
                   "static_cast<unsigned int>(state.fault_address));\n"
