                      "PSP_MAIN_THREAD_ATTR(THREAD_ATTR_USER | "
                      "THREAD_ATTR_VFPU);\n"
                      "PSP_MAIN_THREAD_STACK_SIZE_KB(256);\n"
                      "PSP_HEAP_SIZE_KB(1024);\n\n"
